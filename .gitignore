# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Ohne führenden Slash: greift auf JEDER Verzeichnisebene, nicht nur im Root —
# sonst rutscht z.B. electron/node_modules (electron-updater fürs
# Electron-Bundling, siehe electron/package.json) versehentlich mit ins Repo.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/
.idea/

# Claude Code — lokale, personenbezogene Session-Einstellungen
.claude/settings.local.json

# persönliches Deploy-Skript (referenziert privaten Server) — lokal behalten,
# nicht committen; siehe GITHUB_SETUP.md für den öffentlichen Release-Weg
/deploy.sh

# interne Design-Explorationen — nicht für die Öffentlichkeit bestimmt
/internal-notes/

# Ad-hoc-Verifikationsskripte (Playwright-Checks während der Entwicklung,
# werden nach Gebrauch wieder gelöscht — falls doch mal eins übrig bleibt)
*.tmp.mjs

# Electron-Build-Ausgabe
/dist/
/dist-electron/
/release/
